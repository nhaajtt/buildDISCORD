DISCORD_TOKEN=
CLIENT_ID=
# Optional: register commands on one server only (instant) instead of globally
GUILD_ID=

# Invite links posted in the DJ booth channel (bots cannot add other bots, so a human clicks these)
MUSIC_BOT_INVITE_URL=
TTS_BOT_INVITE_URL=

# Discord user IDs (comma separated) who may use /admin
OWNER_IDS=

# AI design (/thietke): key from https://aistudio.google.com/apikey
# GEMINI_MODEL is a model name that is free for your key in Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional
DATA_DIR=data
ALERT_WEBHOOK_URL=

# Shown by /goi (how to buy an activation code)
CONTACT_TEXT=

# Card payments through Stripe (https://dashboard.stripe.com/apikeys). A secret key (sk_live_...) or a restricted key switches /mua on for cards.
STRIPE_SECRET_KEY=

# Automatic payments through payOS (https://payos.vn), for buyers in Vietnam. All three are needed; without them /mua explains how to buy by hand.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Dong per US dollar used for the price shown and charged (update it when the rate moves)
USD_VND_RATE=26000
# Where payOS sends a customer after paying or cancelling
SITE_URL=https://builddiscord.vercel.app
# The time zone people schedule events in
TIMEZONE=Asia/Ho_Chi_Minh

# Servers that get every feature with no license (your own and test servers), comma separated server IDs
UNLOCKED_GUILD_IDS=

# Web dashboard (leave blank to keep it off). Redirect to add in the Discord Developer Portal: <DASHBOARD_URL>/auth/callback
DISCORD_CLIENT_SECRET=
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
DASHBOARD_URL=
DASHBOARD_PORT=8788
